(platform (linux)
  (defcfg
    ;;67keys FireWolf usb 동글 연결시 키보드. lsusb로는 sharkoon이라는 이름으로 나온다.
    ;;ls -l /dev/input/by-id/ | grep -i kb
    linux-dev (
      /dev/input/by-id/usb-1ea7_2.4G_RF_Keyboard___Mouse-event-kbd
      /dev/input/by-id/usb-ZXW_USB_Keyboard_123456-event-kbd
      /dev/input/by-id/usb-KEYBOARD_AJAZZ_AK029-event-kbd
    )
  )
)

;; interception driver 문제때문인지, 이걸 install하고 나니까, ajazz한손키보드와 emake키보드가 인식이 안됨.
