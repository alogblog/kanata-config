;; 공통 블록을 먼저 불러옵니다.
(include "alias_common.kbd")

;; =======================================================================
;; 5. 샤르쿤 미니 키보드용 기본 베이스 레이어 (40개 자판 순서 완벽 일치)
;; - 일반 키보드와 100% 동일하지만, 오직 좌측 상단 첫 번째 물리 키만 'grave(` / ~)'로 교정됩니다.
;; ==================================================================
(deflayer default
  grave    1    2    3    4    5    6    7    8    9    0    -    =   
  @cap_mod q    w    e    r    t    y    u    i    o    p    [    ]   
  a        s    d    f    g    h    j    k    l    ;    '    bksl
  z        x    c    v    b    n    m    ,    .    rsft @f24_mod
  @lalt_mod     spc  @ralt_mod @rctl_keylock_off_mod bspc enter left right up down del
)

;; 공통 초능력 레이어 블록을 아래에 불러옵니다.
(include "layer_common.kbd")
