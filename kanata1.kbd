;; 1. 기존 방식은 한손 키보드의 20개(1-6,qwert,asdfg,zxcv, b제외)를 모두 일반키보드에서 다른 목적으로 keep하기 위한 방법.
;;(include "localkey.kbd")

;; kanata1 - 한손키보드 dumb translator
;;(defsrc
;;  q w e r t   a s d f g   z x c v b   1 2 3 4 5 6
;;  grv tab caps lsft lctl lmet lalt
;;)
;;(deflayer base
;;  cq cw ce cr ct   ca cs cd cf cg   cz cx cc cv _   c1 c2 c3 c4 c5 c6
;;
;;_  _  _  _  _    _  _
;;)
;; 2. 새로운 방식은, 실제 다른 목적으로 사용할 키는 rtdfgcv 7키뿐이므로 기존의 f13~f24로 충분하기에, 간단히 접근.
(defsrc
  r t
  d f g
  c v
)
(deflayer base
  f13 f14
  f15 f16 f17
  f18 f19
)

