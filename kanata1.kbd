(defcfg
  linux-dev (
    /dev/input/by-id/usb-KEYBOARD_AJAZZ_AK029-event-kbd
  )
  ;; 사용도중에 먹통이 되면 죽도록. 그러면 systemd가 다시 시작하도록.
  ;; 대신 처음 부팅시에는 timer를 이용해서 ak029 장치가 연결되어야 시작하게.
  linux-continue-if-no-devs-found false

  ;;
  ;; 윈도우.
  ;; kanata1 = Interception (한손만 잡고, 원본은 버림)
  ;; Interception은 잡은 키를 커널에서 바로 드랍시키니까 q 원본은 윈도우로 안 올라갑니다. F13만 SendInput으로 올라갑니다.
  ;; kanata2 = Hook (물리+가짜키(sendinput) 전부 다 듣는 놈)
  ;; kanata2가 interception이 아니라 hook(LLHook)이면 kanata1이 쏜 가짜 F13을 봅니다. 다른 프로세스가 쏜거라 루프 필터에 안 걸립니다.
  ;; 보통키보드는 kanata2가 직접 물리로 잡으니까 q∼6은 그대로 들어옵니다.
  ;; 한손키보드는 이미 kanata1이 원본을 먹어서 q가 직접 안 들어오고, F13으로 변환된 것만 kanata2에 들어옵니다.
  ;; 이게 윈도우에서 리눅스의 /tmp/kanata1 심링크 방식과 동일한 역할입니다.
  ;;
  ;; kanata1: Interception(한손전용) -> SendInput F13
  ;; kanata2: Hook(전체, winIov2버전이 모두 처리) -> F13을 q로 복구
  ;; 두 다 Interception으로 하면 체이닝이 안 되는게 정상이고, 저렇게 하이브리드로 해야 됩니다.
  ;; interception kanata는 처리할 값을 sendinput으로 os로 던지기 때문에, wintercept로 2개 체이닝해도
  ;; 두번째 kanata-wintercept에서는 첫번째 kanata의 출력을 얻을수없다. 즉 두번째는 무조건 winiov2를.
  ;; 이 후에, 한쌍의 키보드 외에 다른 키보드를 연결할 경우에, 그 키보드의 erdfgcv키도 방향키로 작동하게 된다.
  ;; 따라서 만약 새로운 일반키보드가 정상적으로 작동하게 할려면, 그 키보드를 kanata1의 hwid에 등록해야 한다.
  ;; 이건 매크로 키보드의 경우에도 마찬가지로 kanata1에 등록해야 한다.  
  
  windows-interception-keyboard-hwids (
  ;; #4 2.4G - (68Keys) HID\VID_1EA7&PID_0002&REV_0200&MI_00
