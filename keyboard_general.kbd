(platform (linux)
  (defcfg
	;; 샤르쿤 키보드와 가상 kanata 장치 신호를 모두 무시해라! 
	;; K68 Freewolf라고 적힌 키보드의 실제 usb 동글은 sharkoon이라는 이름으로
	;; lsusb에서는 잡히지만, 실제 장치레벨에서는 /dev/input/by-id/에서 확인한 이름을 적어야한다. 
	;; 즉 여기서 2.4G..의 아주 제너릭한 이름은 K68키보드의 동글에 붙은 실제 이름이다. 
	;; 배제는 exclude를 이용해 "이름" 부분  매칭으로 거른다.
	;; 이때 이름은 evtest에서  나오는 이름 부분의 일부.
	
	linux-dev-names-exclude ("2.4G RF Keyboard & Mouse" "ZXW USB Keyboard" "AJAZZ AK029" "kanata")
	
	process-unmapped-keys yes 
	danger-enable-cmd yes
  )
)

(platform (win winiov2 wintercept)
  (defcfg
	;; 현재 윈도우에서 intercept드라이버 에러문제로, 기기별 구분을 사용하기 힘들다.
	windows-interception-keyboard-hwids-exclude (
