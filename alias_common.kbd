;; alias_common.kbd (Polybar 3단계 모드 스위칭 완벽 연동 버전)
(defsrc
  esc      1    2    3    4    5    6    7    8    9    0    -    =   
  caps     q    w    e    r    t    y    u    i    o    p    [    ]   
  a        s    d    f    g    h    j    k    l    ;    '    bksl
  z        x    c    v    b    n    m    ,    .    rsft f24
  lalt     spc  ralt rctl bspc enter left right up down del
)

(platform (linux)
  (defalias
  ;; =======================================================================
  ;; [Polybar IPC 신호 전송 명령어 정의]
  ;; hook capslock 1 ➡️ 평소 소문자 모드 (text)
  ;; hook capslock 2 ➡️ 대문자 잠금 모드 (TEXT)
  ;; hook navlock 2 ➡️ 방향키 전면 잠금 모드 (NAV)
  ;; 끝에 &를 붙여 실행 대기(Block)로 인한 키보드 굳어짐 버그를 완벽 차단합니다.
  ;; =======================================================================
  ;; sig_caps_off (cmd bash -c "polybar-msg hook capslock 1 &")
  ;; sig_caps_on  (cmd bash -c "polybar-msg hook capslock 2 &")
     sig_caps (cmd /home/joon/.local/bin/sync_capslock_status_with_polybar.sh)
     sig_navlock_off (cmd polybar-msg hook navlock 1)
     sig_navlock_on  (cmd polybar-msg hook navlock 2)
	 sig_keyslock_off (cmd polybar-msg hook keyslock 1)
     sig_keyslock_on  (cmd polybar-msg hook keyslock 2)
  )
)
(platform (win winiov2 wintercept)
  (defalias 
	 ;; nav,key-lock은 on/off를 각기 다른 명령으로 처리.
	 ;; caps-lock은 3탭을 별도의 layer를 만들지 않고 바로 간단히 처리하기 위해 on/off시에 항상 같은 스크립트(capslock_status.ps1) 실행.
	 ;; 그 스크립트 내에서 현재 caps 상태를 알아낸후에 osd_nav를 이용해 osd 처리.
	 ;; osd_nav.exe는 osd_nav.ahk AutoHotKey로 컴파일해서 만든 실행파일이다.
	 ;; 따라서 capslock_status.ps1, osd_nav.ahk(소스), osd_nav.exe가 필요하다.
     sig_caps (cmd powershell -WindowStyle Hidden -ExecutionPolicy Bypass -File C:\Users\joon\Documents\kanata\capslock_status.ps1)
     sig_navlock_on  (cmd ./osd_nav.exe NAV)
     sig_navlock_off (cmd powershell -WindowStyle Hidden -Command "Get-Process | Where-Object {$_.MainWindowTitle -eq 'OSD_NAV'} | Stop-Process -Force")
	 sig_keyslock_on  (cmd ./osd_nav.exe KEYS)
     sig_keyslock_off (cmd powershell -WindowStyle Hidden -Command "Get-Process | Where-Object {$_.MainWindowTitle -eq 'OSD_KEYS'} | Stop-Process -Force")
  )
)

(defalias
  ;; ① 만능 CapsLock 제어 스위치 (@cap_mod)
  ;; 1탭: esc
  ;; 1홀드: nav_layer 임시(누르고 있는 동안만)
  ;; 더블탭 후 바로 뗌: nav_lock 영구 고정
  ;; 더블탭 후 그대로 유지(홀드): lctrl (Ctrl+C/V용, 떼면 그냥 해제) 
  ;; 트리플탭은 capslock toggle and sig_capslok 실행.
  cap_mod (tap-dance 300 (
    (tap-hold 150 150 esc (layer-while-held nav_layer))
    (tap-hold 150 150 (multi @sig_navlock_on (layer-switch navlock_layer)) lctrl)
    (multi caps @sig_caps)
  ))
 
  ;; ② Left Alt / Right Alt 조합 임시 방향키 모디파이어
  lalt_mod (tap-dance 200 ((layer-while-held nav_layer) (multi lalt @sig_navlock_on (layer-switch navlock_layer))))
  ralt_mod (tap-dance 200 ((layer-while-held nav_layer) (multi ralt @sig_navlock_on (layer-switch navlock_layer))))
  spc_navlock_on_mod (tap-hold 150 150                  (multi @sig_navlock_off (layer-switch default)) spc)

  ;; ③ 오른쪽 Shift 스마트 스위치
  ;; - 꾹 누르고 있으면 (Hold): 원래 대문자/쌍자음용 순정 무결점 rsft 신호 전송!
  ;; - 가볍게 툭 치면 (Tap): 우회 탭홀드 마법을 통해 caps(대문자 잠금) 신호를 
  ;;   날림과 동시에 Polybar에 노란색 [TEXT](2번) 박스를 쾅! 전송합니다.
  ;; 현재 OFF(default keyboard) 상태에서 탭: caps 전송 + ON 알림 + on레이어로 전환
  ;; rsft_capslock_off_mod (tap-hold-press 120 200 (multi caps @sig_caps_on (layer-switch capslock_layer)) rsft)
  ;; 현재 ON 상태에서 탭: caps 전송 + OFF 알림 + default레이어로 복귀
  ;; rsft_capslock_on_mod (tap-hold-press 120 200 (multi caps @sig_caps_off (layer-switch default)) rsft)
  ;; 쉬프트키를 모디파이어로 사용하는것은 한글입력과 관련해 많은 잠재적 에러가능성 높음.

  ;; ① 평소 방 진입용 (1타/2타 시 내 원래 단축키 기능을 온전히 유지해야 하므로 lctrl 명시)
  rctl_keylock_off_mod (tap-dance 260 (
    rctl (multi @sig_keyslock_on (layer-switch keylock_on_layer))
  ))

  ;; ② ★ [질문자님 제안 반영] 잠금 방 탈출용 (1타/2타 시 책 무게로 인한 신호 투과를 완벽 차단해야 하므로 XX 명시!)
  ;; 1.7.0 파서 규격에 맞게 macro 포장지를 입히고, 1타/2타 자리를 완벽한 블록(XX)으로 봉쇄합니다.
  rctl_keylock_on_mod (tap-dance 260 (
    XX (multi @sig_keyslock_off (layer-switch default))
  ))

  ;; 한손키보드의 스페이스바를 f24로 웹드라이버를 이용해 변경.
  f24_mod (tap-hold-press 200 200 enter (layer-while-held numberpad_layer))
)
